from modules.database import engines

class Config:
    # Mariadb: 'hostname' and 'socket' (unix socket) are mutually exclusive,
    # set an empty string on the one not used (by default, socket is empty)
    db = engines.MariaDB(
        hostname="127.0.0.1",
        socket="",
        username="demo",
        password="demo",
        database="msgur"
    )

    # SQLite: simple database file
    db = engines.SQLite("db/demo.sqlite")

    # Note: only one 'db' can be set at a time.


    # Enable debugging output and templates
    # autoreload features
    debug = False

    # Fetch repository git revision to show it
    # on runtine on page's footer
    gitinfo = True
